{
	"name": "joomla51/j51-emani-template",
	"description": "Emani site template maintained for native Joomla 6 operation",
	"type": "joomla-template",
	"license": "GPL-2.0-or-later",
	"config": {
		"platform": {
			"php": "8.3.0"
		},
		"sort-packages": true
	},
	"require": {
		"php": ">=8.3",
